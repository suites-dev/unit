{
  "name": "suites-monorepo",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://suites.dev",
  "bugs": {
    "url": "https://github.com/suites-dev/suites.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suites-dev/suites.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "scripts": {
    "build": "pnpm lerna run build --stream",
    "lint": "pnpm lerna run lint --parallel",
    "prepare": "husky",
    "test": "pnpm lerna exec pnpm test",
    "e2e": "ts-node local-e2e.ts",
    "validate-tsdoc-links": "ts-node scripts/validate-tsdoc-links.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix"
    ]
  },
  "jest-junit": {
    "ancestorSeparator": " › ",
    "classNameTemplate": "{classname}",
    "outputDirectory": "test-reports",
    "suiteNameTemplate": "{filepath}",
    "titleTemplate": "{title}",
    "uniqueOutputName": "true"
  },
  "packageManager": "pnpm@8.15.9",
  "devDependencies": {
    "@babel/traverse": "7.28.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^12.3.2",
    "@types/jest": "29.5.12",
    "@types/node": "^24.19.2",
    "@types/sinon": "^10.0.20",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "braces": "3.0.3",
    "conventional-changelog-cli": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "inversify": "6.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "29.1.0",
    "jest-junit": "^16.0.0",
    "lerna": "^9.0.7",
    "lint-staged": "^16.1.5",
    "madge": "^7.0.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "^5.0.10",
    "rxjs": "^7.8.2",
    "sinon": "^16.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.6.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.1",
      "handlebars": "^4.7.10",
      "lodash": "^4.18.0",
      "postcss": "^8.5.23",
      "picomatch@<3": "^2.3.2",
      "picomatch@>=4 <5": "^4.0.4",
      "tar@<7.5.18": "^7.5.22",
      "js-yaml@>=3 <4": "^3.15.2",
      "js-yaml@>=4 <5": "^4.3.2",
      "brace-expansion@>=5 <6": "^5.0.12",
      "smol-toml": "^1.9.0",
      "pacote@>=21 <22": "^21.5.2",
      "uuid@<11.1.1": "^11.1.1"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
