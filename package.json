{
  "name": "suites-monorepo",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://suites.dev",
  "bugs": {
    "url": "https://github.com/suites-dev/unit.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suites-dev/unit.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "scripts": {
    "build": "pnpm lerna run build --stream",
    "lint": "pnpm lerna run lint --parallel && pnpm --filter suites-e2e lint",
    "prepare": "husky",
    "test": "pnpm lerna exec pnpm test",
    "e2e": "ts-node local-e2e.ts",
    "validate-tsdoc-links": "ts-node scripts/validate-tsdoc-links.ts",
    "test:release": "node --test scripts/*.test.cjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix"
    ]
  },
  "jest-junit": {
    "ancestorSeparator": " \u203a ",
    "classNameTemplate": "{classname}",
    "outputDirectory": "test-reports",
    "suiteNameTemplate": "{filepath}",
    "titleTemplate": "{title}",
    "uniqueOutputName": "true"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "inversify": "8.2.3",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.4",
    "reflect-metadata": "0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "@swc/jest": "^0.2.39",
    "@swc/core": "^1.16.21",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  }
}
