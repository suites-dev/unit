{
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2017",
    "sourceMap": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "incremental": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "lib": ["es6"],
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
    "strict": false
  },
  "exclude": ["e2e", "index.ts", "node_modules", "dist", "__test__", "env", "coverage"]
}
