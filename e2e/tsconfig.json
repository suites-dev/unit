{
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "incremental": false,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["es2023"],
    "ignoreDeprecations": "6.0",
    "strict": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
