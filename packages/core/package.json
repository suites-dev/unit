  },
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "prebuild": "pnpm rimraf dist",
    "build": "sh ./build.sh",
    "test": "jest --coverage --verbose",
    "lint": "pnpm eslint '{src,test}/**/*.ts'"
