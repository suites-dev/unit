{
  "name": "@suites/doubles.jest",
  "version": "4.1.1",
  "license": "Apache-2.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./unit": {
      "types": "./unit.d.ts"
    }
  },
  "keywords": [
    "mocking",
    "mock",
    "jest",
    "dependency-injection",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/suites-dev/unit.git",
    "directory": "packages/doubles/jest"
  },
  "homepage": "https://suites.dev",
  "bugs": {
    "url": "https://github.com/suites-dev/unit/issues"
  },
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "prebuild": "pnpm rimraf dist",
    "build": "sh ./build.sh",
    "test": "jest --coverage --verbose",
    "lint": "pnpm eslint '{src,test}/**/*.ts'"
  },
  "files": [
    "unit.d.ts",
    "dist"
  ],
  "peerDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "@suites/core.unit": "workspace:^4.1.1",
    "@suites/types.common": "workspace:^4.0.1",
    "@suites/types.di": "workspace:^4.1.1",
    "@suites/types.doubles": "workspace:^4.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.16.1"
}
