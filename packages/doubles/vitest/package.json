{
  "name": "@suites/doubles.vitest",
  "version": "4.0.0",
  "license": "Apache-2.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./unit": {
      "types": "./unit.d.ts"
    }
  },
  "keywords": [
    "mocking",
    "mock",
    "vitest",
    "dependency-injection",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/suites-dev/unit.git",
    "directory": "packages/doubles/vitest"
  },
  "homepage": "https://suites.dev",
  "bugs": {
    "url": "https://github.com/suites-dev/unit/issues"
  },
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "prebuild": "pnpm rimraf dist",
    "build": "sh build.sh",
    "test": "pnpm vitest run --coverage && pnpm test:types",
    "lint": "pnpm eslint '{src,test}/**/*.ts'",
    "test:types": "tsc --ignoreConfig --noEmit --skipLibCheck --strict --target es2020 --module esnext --moduleResolution bundler src/types.spec.ts"
  },
  "files": [
    "unit.d.ts",
    "dist"
  ],
  "peerDependencies": {
    "@vitest/spy": ">= 1.0",
    "vitest": ">= 1.0"
  },
  "dependencies": {
    "@suites/core.unit": "workspace:^4.0.0",
    "@suites/types.common": "workspace:^4.0.0",
    "@suites/types.di": "workspace:^4.0.0",
    "@suites/types.doubles": "workspace:^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/spy": "5.1.0",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.16.1"
}
